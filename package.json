{
  "name": "custom-crafting",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "watch": "vp run -r --parallel watch",
    "ready": "vp check && vp run -r build",
    "prepare": "vp config && vpx tools/link-skills.ts",
    "test": "vp test",
    "link-skills": "vpx tools/link-skills.ts",
    "gen": "vpx tools/gen-assets.ts && vp fmt behavior resource"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bedrock-lang": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
