{
  "include": ["tools", "*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "paths": {
      "@behavior/*": ["./behavior/src/*"]
    }
  }
}
